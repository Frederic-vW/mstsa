# Paper source and build artifacts: local-only, not part of the public
# repo (manuscript source/citations and the JOSS-branded PDF stay
# unpublished until JOSS acceptance; see paper/arXiv/ below for the one
# manuscript file that is public)
paper/publishing-artifacts/
paper/paper.tex
paper/paper.pdf
paper/paper.bib.sav.tmp
paper/paper.bib
paper/paper.md
paper/joss_resources/

# arXiv preprint copy: local-only, not part of the public repo, EXCEPT the
# final compiled PDF (JOSS logo/branding stripped) -- that one stands in
# for the JOSS PDF in the repo until JOSS acceptance (JOSS requires 6
# months of public history, not yet met)
paper/arXiv/*
!paper/arXiv/paper.pdf

# Personal build/publish tooling: hardcoded local paths or depends on
# machine-local tools (~/.local/bin/compile-joss-pdf), not useful/portable
# for external contributors
push_testpypi.sh
paper/compile_joss_pdf.sh
paper/compile_joss_pdf.txt

