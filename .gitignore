# Build artifacts
dist/
build/
*.egg-info/
mstsa/mstsa/
mstsa/home/

# Compiled / cached
__pycache__/
*.py[cod]
*.so
*.o
*.nbc
*.nbi

# CFFI-generated C wrapper files (regenerated by every build from
# mstsa/_*_build.py + mstsa/src/*.c, not source themselves)
mstsa/_c_entropy.c
mstsa/_se.c
mstsa/_lz76.c

# Test / tool caches
.pytest_cache/
.ipynb_checkpoints/

# Editor / tool config (local, not for public repo)
.claude/
mstsa/.claude/

# Paper build artifacts: local-only (source paper.md/paper.bib ARE
# tracked -- JOSS's Whedon build system needs them present in the repo).
# The JOSS-branded compiled PDF stays unpublished until JOSS acceptance;
# see paper/arXiv/ below for the one compiled manuscript PDF that is public.
paper/publishing-artifacts/
paper/paper.tex
paper/paper.pdf
paper/paper.bib.sav.tmp
paper/joss_resources/

# arXiv preprint copy: local-only, not part of the public repo, EXCEPT the
# final compiled PDF (JOSS logo/branding stripped) -- that one stands in
# for the JOSS PDF in the repo until JOSS acceptance
paper/arXiv/*
!paper/arXiv/paper.pdf

# Personal build/publish tooling: hardcoded local paths or depends on
# machine-local tools (~/.local/bin/compile-joss-pdf), not useful/portable
# for external contributors
push_testpypi.sh
paper/compile_joss_pdf.sh
paper/compile_joss_pdf.txt

# Backup of the old .git history (had Claude co-authorship trailers baked
# into commit messages) -- kept locally for reference only, never tracked
.git-old-with-claude-trailers/
